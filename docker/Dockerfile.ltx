# ltx-comfy — ComfyUI with the LTX-2.3 node stack.
#
# Why this exists, given ltx-runner already drives LTX from the CLI:
#
# The CLI cannot reproduce the workflows the community generates with. It
# exposes no sampler, scheduler, shift, sigma or denoise control at all --
# grepped, zero hits -- and hardcodes a sampler per pipeline (LTX_2_3_HQ's own
# comment says "Res2s sampler"). RuneXX's LTX-2.3 workflows set
# euler_cfg_pp / euler_ancestral_cfg_pp, linear_quadratic scheduling,
# LTXVScheduler shift 2.05 / base 0.95 / terminal 0.1, and explicit ManualSigmas
# per pass. None of that is reachable through ltx-pipelines' argparse, so six CLI
# renders tuning the four knobs it does expose could not close the quality gap.
#
# Separate container from keyframe-server on purpose. LTX-2.3 wants essentially
# the whole card and Qwen holds ~20 GB once loaded, so they cannot be co-resident
# on 24 GB whatever we do -- one has to yield. Keeping them apart also means a
# broken node install here cannot take the working Qwen/LivePortrait image down
# with it.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv git curl ca-certificates \
        libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# torch first and alone so a resolver backtrack cannot quietly pick another
# build. Same pair as the keyframe-server image, which is proven on this GPU.
#
# No torchaudio: there is no 2.12.x release (published stops at 2.11.0), and
# pinning it would either fail the build or drag torch backwards to match. If a
# node turns out to need it, add it explicitly against whatever torch resolves
# to rather than letting the resolver choose for both.
RUN pip install --no-cache-dir "torch==2.12.1" "torchvision==0.27.1"

ARG COMFYUI_COMMIT=master
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI \
 && cd /app/ComfyUI \
 && if [ "$COMFYUI_COMMIT" != "master" ]; then git checkout ${COMFYUI_COMMIT}; fi \
 && pip install --no-cache-dir -r requirements.txt

WORKDIR /app/ComfyUI/custom_nodes

# The four packs the LTX-2.3 workflows actually reference. Pinned to a commit
# would be better, but these move fast against ComfyUI core and a stale pin
# breaks node loading more often than a fresh clone does. Revisit if it bites.
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git \
 && git clone https://github.com/kijai/ComfyUI-KJNodes.git \
 && git clone https://github.com/rgthree/rgthree-comfy.git \
 && git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git \
 && git clone https://github.com/city96/ComfyUI-GGUF.git

# Each pack's own deps. Done in one layer so a single failure is visible rather
# than silently leaving a half-installed node tree.
RUN for d in ComfyUI-LTXVideo ComfyUI-KJNodes rgthree-comfy \
             ComfyUI-VideoHelperSuite ComfyUI-GGUF; do \
        if [ -f "$d/requirements.txt" ]; then \
            echo "=== deps for $d ===" && pip install --no-cache-dir -r "$d/requirements.txt" || exit 1; \
        fi; \
    done

WORKDIR /app/ComfyUI

# Models are bind-mounted, never baked: the LTX-2.3 set alone is ~126 GB.
ENV COMFY_PORT=8188 \
    MODELS_DIR=/workspace/models \
    YOLO_CONFIG_DIR=/tmp/ultralytics

COPY docker/extra_model_paths.ltx.yaml /opt/extra_model_paths.yaml
COPY docker/start-ltx.sh /opt/start-ltx.sh
RUN chmod +x /opt/start-ltx.sh

ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA

EXPOSE 8188
CMD ["/opt/start-ltx.sh"]
